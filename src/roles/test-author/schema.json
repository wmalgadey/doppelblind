{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tests", "assumptions"],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "description": "Every test file written, each with the one criterion its tests cover. Helper files are not listed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "criterion"],
        "properties": {
          "file": { "type": "string", "minLength": 1, "description": "Path of the test file relative to the working directory." },
          "criterion": { "type": "string", "pattern": "^AC-[0-9]{3,}$" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Every decision a test makes that its criterion does not, in English.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "assumption"],
        "properties": {
          "criterion": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
          "assumption": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
