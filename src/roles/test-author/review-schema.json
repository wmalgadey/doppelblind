{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "steps", "where", "observe"],
        "properties": {
          "criterion": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "where": { "type": "string", "minLength": 1 },
          "observe": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
