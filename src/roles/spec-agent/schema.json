{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "short_name", "criteria", "wishes", "open_questions"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Short title of the change, in English."
    },
    "short_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,3}$",
      "description": "2-4 lowercase words joined by dashes; names the spec folder."
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "given", "when", "then", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
          "title": { "type": "string", "minLength": 1 },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "anchor"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "anchor": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "wishes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]{2,}$" },
          "question": { "type": "string", "minLength": 1 },
          "context": { "type": "string" }
        }
      }
    }
  }
}
