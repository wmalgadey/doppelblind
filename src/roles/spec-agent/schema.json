{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "short_name", "introduction", "criteria", "wishes", "open_questions"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Short title of the change, in English."
    },
    "short_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,3}$",
      "description": "2-4 lowercase words joined by dashes; names the spec folder."
    },
    "introduction": {
      "type": "string",
      "minLength": 1,
      "description": "Prose: which problem the change solves, for whom, and what it deliberately leaves out. Introduces no requirement."
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          { "properties": { "reason_in_source": { "type": "null" }, "reason_anchor": { "type": "null" } } },
          {
            "properties": {
              "reason_in_source": { "type": "string", "minLength": 1 },
              "reason_anchor": { "type": "string", "minLength": 1 }
            }
          }
        ],
        "required": ["id", "title", "reason_in_source", "reason_anchor", "given", "when", "then", "rejects", "proven_by", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "reason_in_source": {
            "type": ["string", "null"],
            "description": "The reason the brief or a cited source gives for the criterion, in one sentence; null if no source gives one. Never a reason of your own, and never a restatement of the source, given, when or then."
          },
          "reason_anchor": {
            "type": ["string", "null"],
            "description": "Text that appears verbatim in one of the criterion's cited sources, where that source gives the reason; if the reason comes from a source not yet cited, add that source to sources. Null exactly when reason_in_source is null."
          },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "rejects": {
            "type": "string",
            "minLength": 1,
            "description": "One concrete wrong implementation this criterion fails, and which part of the Then makes the test fail for it (or, if proven by review, by which part the user spots it)."
          },
          "proven_by": {
            "enum": ["test", "review"],
            "description": "`test` if an acceptance test can decide the criterion; `review` if only the user's review can."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "anchor"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "anchor": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "wishes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "concerns"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]{2,}$" },
          "question": { "type": "string", "minLength": 1 },
          "concerns": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
            "description": "IDs of the criteria whose behaviour the answer would change; may be empty."
          },
          "context": { "type": "string", "description": "The step of the brief the question is about, in one sentence." },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^Q-[0-9]{2,}$" }
          }
        }
      }
    }
  }
}
